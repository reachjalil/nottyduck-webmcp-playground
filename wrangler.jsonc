{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nottyduck-webmcp-playground",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "playground.nottyduck.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
